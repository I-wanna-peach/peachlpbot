# One channel list. Both chains run inside the same process.
CHAINS=bsc,arc

# Chain access. These endpoints are IP-whitelisted for the Seoul host, so they
# will not answer from a laptop. Never commit the real key.
BSC_RPC_URL=
ARC_RPC_URL=

# One database per deployment.
DATABASE_URL=postgres://peach:peach@127.0.0.1:5432/peachlpbot
DATABASE_SOCKET_PATH=

# Telegram bot (long polling; no inbound port is opened).
TELEGRAM_BOT_TOKEN=
MAX_SUBSCRIPTIONS_PER_CHAT=20
COMMUNITY_GROUP_URL=
COMMUNITY_X_URL=

# Per-chain overrides win over the global value; a missing override inherits it.
# INDEXER_START_BLOCK pins the first block instead of deriving it from lookback.
BSC_LOG_CHUNK_SIZE=5000
BSC_LOOKBACK_BLOCKS=5000000
BSC_MAX_CHUNKS_PER_RUN=50
BSC_POLL_INTERVAL_MS=5000
# BSC_INDEXER_START_BLOCK=

ARC_LOG_CHUNK_SIZE=10000
ARC_LOOKBACK_BLOCKS=2000000
ARC_MAX_CHUNKS_PER_RUN=50
ARC_POLL_INTERVAL_MS=3000
# ARC_INDEXER_START_BLOCK=

INDEXER_TAIL_WINDOW_BLOCKS=20000
INDEXER_REORG_REWIND=128

# Range alerts. An upper bound is exclusive: tickLower <= tick < tickUpper.
OUT_OF_RANGE_CONFIRM_BLOCKS=2
IN_RANGE_CONFIRM_BLOCKS=3
NOTIFY_BACK_IN_RANGE=false
ALERT_RULES_VERSION=1
